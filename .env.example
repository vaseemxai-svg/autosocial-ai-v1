# =============================================================
# AutoSocial AI v1 — Environment Configuration
# =============================================================
# Copy this file to .env and fill in ONLY the values you need.
# NEVER commit the real .env file to git (.gitignore handles it).
# =============================================================

# ------------------------------------------------------------
# MODE
# ------------------------------------------------------------
# true  = nothing ever posts to Instagram (safe for development)
# false = real posts via Graph API (requires IG_ACCOUNT_ID + IG_ACCESS_TOKEN)
MOCK_MODE=true

# ------------------------------------------------------------
# BLOCKER 2 — HARD LIVE-PUBLISH SAFETY GATE
# ------------------------------------------------------------
# A second, harder gate INDEPENDENT of MOCK_MODE. Even when MOCK_MODE=false,
# live Instagram API calls are blocked unless this is explicitly set to true.
# Default MUST be false. Only set true for an approved real post.
ENABLE_LIVE_INSTAGRAM_PUBLISH=false

# ------------------------------------------------------------
# INSTAGRAM (only needed when MOCK_MODE=false)
# ------------------------------------------------------------
# Setup: Meta Developer Console -> App -> Instagram Graph API.
# IG_USERNAME: your page handle (display only)
IG_USERNAME=laggaye_broo
# IG_ACCOUNT_ID: your Instagram Business/Creator numeric account ID
IG_ACCOUNT_ID=
# IG_ACCESS_TOKEN: long-lived token from Graph API Explorer
# (permissions: instagram_basic, instagram_content_publish, pages_manage_posts)
IG_ACCESS_TOKEN=

# ------------------------------------------------------------
# GOOGLE DRIVE (only needed when MOCK_MODE=false)
# ------------------------------------------------------------
# 1. Google Cloud Console -> IAM -> Service Accounts -> create account,
#    download the JSON key, and set the path below.
# 2. Share the Drive folder with the service account email (Editor):
#    https://drive.google.com/drive/folders/<your-folder-id>
#    -> Share -> paste service account email
GOOGLE_DRIVE_FOLDER_ID=1XpGs0_l_RBcCHAj3O3wO3diavtcRnNt6
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./config/service_account.json

# ------------------------------------------------------------
# SCHEDULER
# ------------------------------------------------------------
# Comma-separated 24h times (your TIMEZONE) — generation slots, NOT post slots.
# Content is generated + queued for human review in the web UI.
GENERATION_TIMES=09:00,19:00
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------
# TREND COLLECTOR
# ------------------------------------------------------------
# MOCK_DEFAULT = deterministic best-first ordering (good for tests)
# RANDOMISED   = weighted-random ordering (daily variety)
TREND_COLLECTOR_MODE=MOCK_DEFAULT

# ------------------------------------------------------------
# WEB UI
# ------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ------------------------------------------------------------
# WEB API SECRET — minimal auth for /post-now (CTO requirement)
# ------------------------------------------------------------
# If set, every POST to /post-now MUST carry header:
#   Authorization: Bearer <WEB_API_SECRET>
# Empty = localhost-only (same as before). When deploying anywhere
# reachable from the internet, generate a random secret, e.g.:
#   openssl rand -hex 24
WEB_API_SECRET=
