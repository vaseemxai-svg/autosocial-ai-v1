# Secrets — never commit
.env
config/service_account.json
# Only specific sensitive JSON paths are excluded. Legitimate pipeline data
# JSON (e.g. mock_data/sample_trends.json) stays committed so the pipeline
# always has something to read.
secrets/*.json
output/logs/publish_log.json
output/logs/mock_uploads.json
# Local outputs (Drive is the source of truth)
output/
# Python
__pycache__/
*.pyc
.pytest_cache/
